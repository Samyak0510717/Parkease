# Copy this file to .env or add these values to your hosting environment.
# Never commit a real password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parkease
DB_USER=parkease_app
DB_PASS=replace-with-your-mysql-password

# Gmail SMTP for sending booking confirmation emails.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on your Google Account)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SENDER_EMAIL=your-gmail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Khalti Payment Gateway (e-Payment v2)
# Sign up at https://admin.khalti.com/ (live) or https://test-admin.khalti.com/ (sandbox)
# Use your Merchant Secret Key from the Khalti dashboard
KHALTI_SECRET_KEY=your-khalti-secret-key-here
KHALTI_ENVIRONMENT=sandbox